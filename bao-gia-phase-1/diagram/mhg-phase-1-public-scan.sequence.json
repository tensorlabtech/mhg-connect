      { "id": "cache-miss", "label": "Cache MISS", "focus": ["edgeCache", "web", "api", "redis", "db"], "note": "Next.js gọi API tra trạng thái. Hồ sơ active được cache; ActivationView, LockedView và lỗi dùng no-store." },
      { "id": "analytics", "label": "Đo traffic", "focus": ["visitor", "web", "api"], "note": "Frontend gửi scan_event khi route mở và profile_view khi hồ sơ active hiển thị. Đây là số liệu gần đúng, không làm chậm HTML." }
    ]
