    { "id": "api", "type": "backend", "label": "NestJS API", "sublabel": "Prisma · nghiệp vụ" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "mapping cache" },
    { "id": "db", "type": "database", "label": "PostgreSQL", "sublabel": "source of truth" }
  ],
  "segments": [
    { "from": 150, "to": 255, "label": "Đường đẹp: chỉ Cloudflare" },
    { "from": 275, "to": 545, "label": "Chỉ chạy khi cache miss" },
    { "from": 565, "to": 656, "label": "Analytics phía browser" }
  ],
  "messages": [
