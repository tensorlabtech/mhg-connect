{
  "name": "mhg-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate-deployment-env.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "NODE_OPTIONS='--conditions react-server' tsx scripts/seed-demo-data.ts",
    "qr:generate": "tsx scripts/generate-demo-qr.ts",
    "env:check": "tsx scripts/validate-deployment-env.ts --strict",
    "test": "vitest run",
    "test:integration": "NODE_OPTIONS='--conditions react-server' vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
