# Neon Postgres connection string
DATABASE_URL=

# Better Auth server-only values
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Backblaze B2 S3-compatible profile media storage
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional override; defaults to https://<bucket>.<s3-endpoint>
B2_PUBLIC_URL_BASE=

# Legacy Vercel Blob fallback for existing environments
BLOB_READ_WRITE_TOKEN=

# Seed-only credentials; do not use NEXT_PUBLIC prefixes
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MHG Admin
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Public base URL used to generate printable QR images
APP_URL=
RELEASE_QR=false

# Keep internal catalogue routes private in production by default
ENABLE_DEV_ROUTES=false

# Local development only: "local" saves uploaded images to public/_uploads instead of B2
MEDIA_STORAGE=
