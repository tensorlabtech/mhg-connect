# Neon Postgres connection string
DATABASE_URL=

# Better Auth server-only values
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob server upload token
BLOB_READ_WRITE_TOKEN=

# Seed-only credentials; do not use NEXT_PUBLIC prefixes
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MHG Admin
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Public base URL used to generate printable QR images
APP_URL=
RELEASE_QR=false

# Keep internal catalogue and quotation routes private in production by default
ENABLE_DEV_ROUTES=false
